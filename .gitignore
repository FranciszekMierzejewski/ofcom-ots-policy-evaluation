# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Data (raw and processed data should not be committed) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.xlsx
*.xls
*.parquet
*.pkl
*.pickle
!variable_mapping.csv
!schema_diff.csv

# --- Outputs ---
outputs/figures/*
!outputs/figures/.gitkeep

# --- Environment / secrets ---
.env
.env.*
*.key

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Logs ---
*.log