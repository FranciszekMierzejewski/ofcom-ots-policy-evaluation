# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Data
data/raw/*
data/processed/*


!data/raw/.gitkeep
!data/processed/.gitkeep

# Common data formats
*.csv
*.xlsx
*.xls
*.parquet
*.pkl
*.pickle

# track docs
!docs/
!docs/**

# Project outputs
outputs/
results/
figures/
reports/generated/


!outputs/.gitkeep
!results/.gitkeep
!figures/.gitkeep
!reports/generated/.gitkeep